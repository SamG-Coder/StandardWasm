<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- [SkipLocalsInit] needs C# 9 and /unsafe. -->
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/AssemblyReader/*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../src/PortableCompiler/*.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
