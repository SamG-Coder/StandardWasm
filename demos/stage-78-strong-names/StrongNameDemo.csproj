<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>fixture-a.public.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Dependency/**/*.cs;Alternate/**/*.cs" />
    <ProjectReference Include="Dependency/SignedDependency.csproj" />
    <Compile Include="../../src/AssemblyReader/*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../src/PortableCompiler/*.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
